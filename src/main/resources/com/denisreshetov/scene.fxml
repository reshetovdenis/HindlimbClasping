<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.media.MediaView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.Tab?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.denisreshetov.FXMLController">
    <!-- Menu Bar at the top -->
    <top>
        <MenuBar>
            <Menu text="Project">
                <MenuItem text="New/Open Project" onAction="#handleProject"/>
                <MenuItem text="Export to Excel" onAction="#handleExport"/>
            </Menu>
        </MenuBar>
    </top>
    <left>
        <VBox spacing="10" alignment="CENTER">
            <padding>
                <Insets top="10" right="0" bottom="10" left="0"/>
            </padding>
            <HBox alignment="CENTER" spacing="10">
                <Label text="Videos:"/>
                <Button fx:id="addVideoButton" text="+" onAction="#handleAddVideo" disable="true"/>
                <Button fx:id="removeVideoButton" text="-" onAction="#handleRemoveVideo" disable="true"/>
            </HBox>
            <ListView fx:id="videoListView" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>
    <right>
        <VBox spacing="10" alignment="CENTER">
            <padding>
                <Insets top="10" right="0" bottom="10" left="0"/>
            </padding>
            <HBox alignment="CENTER" spacing="10">
                <Label text="Mice:"/>
                <Button fx:id="removeMouseButton" text="-" onAction="#handleRemoveMouse" disable="true"/>
            </HBox>
            <TableView fx:id="miceTableView" VBox.vgrow="ALWAYS" prefWidth="200">
                <columns>
                    <TableColumn fx:id="mouseIdColumn" text="Mouse ID"/>
                    <TableColumn fx:id="timeColumn" text="Time"/>
                    <TableColumn fx:id="fileColumn" text="File" prefWidth="300"/>
                </columns>
            </TableView>
        </VBox>
    </right>

    <!-- Existing VBox layout in the center -->
    <center>
        <TabPane>
            <!-- Tab 1 with existing mainContainer -->
            <Tab text="Video">
                <VBox fx:id="mainContainer" spacing="10" alignment="CENTER" prefWidth="1200">
                    <VBox fx:id="player" spacing="10" alignment="CENTER" prefWidth="1200">

                        <MediaView fx:id="mediaView" fitHeight="500"/>
                        <HBox fx:id="mediaControl" alignment="CENTER" spacing="10">
                            <Button fx:id="fullScreenButton" text="" onAction="#handleMediaViewFullScreenToggle">
                                <graphic>
                                    <ImageView>
                                        <Image url="@../../images/expand.png"/>
                                    </ImageView>
                                </graphic>
                            </Button>
                            <Button fx:id="togglePlayPauseButton" onAction="#handleTogglePlayPause" disable="true">
                                <graphic>
                                    <ImageView>
                                        <Image url="@../../images/play.png"/>
                                    </ImageView>
                                </graphic>
                            </Button>
                            <Slider fx:id="videoSlider" prefWidth="300" disable="true"/>
                            <Label fx:id="timeLabel" text="0.0 s" prefWidth="50"/>
                        </HBox>
                        <Label fx:id="videoName"/>
                    </VBox>
                    <VBox fx:id="mouseInput" alignment="CENTER" spacing="10">
                        <HBox alignment="CENTER" spacing="10">
                            <TextField fx:id="mouseIdInput"
                                       promptText="Enter Mouse ID" disable="true"/>
                            <Button fx:id="submitMouseIdButton"
                                    text="Set start"
                                    onAction="#handleSubmitMouseId"
                                    styleClass="wide-button" disable="true"/>
                        </HBox>
                    </VBox>
                </VBox>
            </Tab>
            <!-- Tab 2 with new scoring container -->
            <Tab text="Scoring">
                <VBox fx:id="scoring" spacing="10" alignment="CENTER">
                    <MediaView fx:id="scoringView" fitHeight="500"/>
                    <VBox alignment="CENTER" spacing="10">
                        <HBox fx:id="frameButtons" alignment="CENTER" spacing="10">
                        </HBox>
                    </VBox>
                    <HBox alignment="CENTER" spacing="10">
                        <HBox fx:id="legState" alignment="CENTER" spacing="10">
                            <Button fx:id="leftRetracted"
                                    text=""
                                    onAction="#handleLeftRetracted"
                                    styleClass="mark-state">
                                <graphic>
                                    <ImageView>
                                        <Image url="@../../images/leftRetracted.png"/>
                                    </ImageView>
                                </graphic>
                            </Button>
                            <Button fx:id="leftOK"
                                    text=""
                                    onAction="#handleLeftOK"
                                    styleClass="mark-state">
                                <graphic>
                                    <ImageView>
                                        <Image url="@../../images/leftOK.png"/>
                                    </ImageView>
                                </graphic>
                            </Button>
                            <Button fx:id="rightOK"
                                    text=""
                                    onAction="#handleRightOK"
                                    styleClass="mark-state">
                                <graphic>
                                    <ImageView>
                                        <Image url="@../../images/rightOK.png"/>
                                    </ImageView>
                                </graphic>
                            </Button>
                            <Button fx:id="rightRetracted"
                                    text=""
                                    onAction="#handleRightRetracted"
                                    styleClass="mark-state">
                                <graphic>
                                    <ImageView>
                                        <Image url="@../../images/rightRetracted.png"/>
                                    </ImageView>
                                </graphic>
                            </Button>

                        </HBox>
                    </HBox>
                    <HBox alignment="CENTER" spacing="10">
                        <Button fx:id="naFrame"
                                text="NA frame"
                                onAction="#handleNAFrame"
                                styleClass="wide-button"/>
                    </HBox>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>